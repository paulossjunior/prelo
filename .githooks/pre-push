#!/bin/sh
# Trava local de push (FR-010, constituição: Fluxo de Desenvolvimento). Não use --no-verify.
# Gitflow: push para a main ou de tag roda a suíte completa; feature/* e dev rodam o modo
# rápido (sem build nem e2e). Qualquer falha bloqueia o push.
mode=quick
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/tags/*) mode=full ;;
  esac
done

if [ "$mode" = full ]; then
  echo "pre-push: rodando npm run verify (suíte completa: main ou tag)"
  npm run verify
else
  echo "pre-push: rodando npm run verify -- --quick (feature/dev; o completo roda no PR para a main)"
  npm run verify -- --quick
fi
status=$?
if [ "$status" -ne 0 ]; then
  echo "pre-push: BLOQUEADO. npm run verify falhou; veja as etapas acima." >&2
fi
exit "$status"
