<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="pt-BR">
  <info>
    <title>ABNT simplificado (fixture de teste do Prelo)</title>
    <id>http://prelo.invalid/styles/abnt-teste</id>
    <updated>2026-11-19T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter="; " and="text"/>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author">
      <name form="short" delimiter="; " and="text"/>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>
  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <text macro="author-short" text-case="uppercase"/>
      <text macro="year" prefix=", "/>
    </layout>
  </citation>
  <bibliography>
    <sort><key macro="author"/></sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="author" text-case="uppercase"/>
        <text variable="title" font-weight="bold"/>
        <text variable="container-title" font-style="italic"/>
        <text variable="publisher"/>
        <text macro="year"/>
      </group>
    </layout>
  </bibliography>
</style>
